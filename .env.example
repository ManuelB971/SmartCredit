POSTGRES_DB=smartcredit
POSTGRES_USER=smartcredit
POSTGRES_PASSWORD=smartcredit
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# IA locale (Ollama)
# Si le backend tourne en Docker, Ollama est joignable via host.docker.internal
OLLAMA_HOST=http://host.docker.internal:11434
AI_MODEL=llama3.1:8b
AI_TIMEOUT_SEC=6

# Email (envoi du rapport PDF)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=SmartCredit <noreply@smartcredit.fr>

